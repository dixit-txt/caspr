# caspr-core — .env.example
#
# Every key this service reads via os.getenv(), generated from the source and
# grouped by area. Copy to .env and fill in. NEVER commit .env — it is
# gitignored, and the values are live credentials.
#
# caspr-core is the only service that holds Postgres credentials and runs
# Alembic. The three service-split keys at the top are what make the four-repo
# wiring work; everything else is inherited from the monolith.

# ── service split: where the siblings live ─────────────────────────────────
# Defaults in src/config/constants.py are these localhost values, for four
# uvicorns on one laptop. docker-compose.yml overrides them with the compose
# service names (http://file-handling:8010, http://render-report:8020).
GREP_SERVICE_BASE_URL=http://localhost:8010
REPORT_RENDER_SERVICE_BASE_URL=http://localhost:8020
# Sent as `x-internal-secret` to render-report's /internal/render/* routes.
# Leave EMPTY in DEV: render-report skips the check when unset, so curl and the
# testing notebook work. Set it here and in render-report/.env (same value) to
# turn internal auth on.
INTERNAL_API_SECRET=

