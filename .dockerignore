# The image builds its own /app/.venv via `uv sync`. Copying the host venv in
# would shadow it with binaries built against a different interpreter/libc.
.venv/
venv/

# Secrets must be injected at run time (env vars / secrets manager), never
# baked into an image layer.
.env
.env.*
!.env.example

.git/
.gitignore
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.log

Dockerfile
.dockerignore
README.md

# ── tool caches ────────────────────────────────────────────────────────────
.mypy_cache

# ── tests and dev-only material: not shipped, and they invalidate the layer
# ── on every edit. db_migrations/ and alembic.ini are deliberately NOT here —
# ── this is the only service that owns Postgres, and the image is what runs
# ── `alembic upgrade head`.
tests
*.ipynb
.ipynb_checkpoints

# ── editor / OS ────────────────────────────────────────────────────────────
.vscode
.idea
.cursorignore
.DS_Store
